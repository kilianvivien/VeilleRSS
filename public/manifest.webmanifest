{
  "name": "Outil de veille RSS",
  "short_name": "Veille RSS",
  "description": "Lecteur de flux RSS : veille de presse, tendances et briefing IA.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["news", "productivity"],
  "background_color": "#ffffff",
  "theme_color": "#4c8dff",
  "icons": [
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/captures/capturearticle.png",
      "sizes": "1206x2622",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Articles et recherche dans les flux RSS"
    },
    {
      "src": "/captures/capturetendances.png",
      "sizes": "1206x2622",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tendances détectées dans les sources suivies"
    },
    {
      "src": "/captures/capturebriefing.png",
      "sizes": "1206x2622",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Briefing de veille généré à partir des articles"
    },
    {
      "src": "/captures/capturecarte.png",
      "sizes": "1206x2622",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Carte des sujets et de leurs relations"
    }
  ],
  "shortcuts": [
    {
      "name": "Articles non lus",
      "short_name": "Non lus",
      "url": "/?view=unread",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Articles sauvegardés",
      "short_name": "Sauvegardés",
      "url": "/?view=saved",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Tendances",
      "short_name": "Tendances",
      "url": "/?view=trends",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
