{
  "name": "Outil de veille RSS",
  "short_name": "Veille RSS",
  "description": "Lecteur de flux RSS : veille de presse, tendances et briefing IA.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["news", "productivity"],
  "background_color": "#ffffff",
  "theme_color": "#6a5ae0",
  "icons": [
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/ordinateur@0.5x.png",
      "sizes": "1549x995",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tableau de veille, articles et tendances sur ordinateur"
    },
    {
      "src": "/screenshots/iphone@0.5x.png",
      "sizes": "603x1311",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Lecture et recherche dans les flux RSS sur mobile"
    },
    {
      "src": "/screenshots/android@0.5x.png",
      "sizes": "540x1200",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cartographie interactive des tendances sur mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Articles non lus",
      "short_name": "Non lus",
      "url": "/?view=unread",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Articles sauvegardés",
      "short_name": "Sauvegardés",
      "url": "/?view=saved",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Tendances",
      "short_name": "Tendances",
      "url": "/?view=trends",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
